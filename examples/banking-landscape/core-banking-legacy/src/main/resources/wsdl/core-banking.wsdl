<?xml version="1.0" encoding="UTF-8"?>
<definitions name="CoreBanking" targetNamespace="http://core.bank.com/"
             xmlns="http://schemas.xmlsoap.org/wsdl/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
             xmlns:tns="http://core.bank.com/">
  <portType name="CoreBankingPort">
    <operation name="GetLedgerBalance"/>
    <operation name="PostLedgerEntry"/>
  </portType>
  <binding name="CoreBankingBinding" type="tns:CoreBankingPort">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http"/>
  </binding>
  <service name="CoreBankingService">
    <port name="CoreBankingPort" binding="tns:CoreBankingBinding">
      <soap:address location="http://core-banking-legacy:8080/ws/core"/>
    </port>
  </service>
</definitions>
